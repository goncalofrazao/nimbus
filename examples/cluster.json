{
  "workloads": [
    {
      "name": "web",
      "image": "nginx:alpine",
      "replicas": 2,
      "liveness": {
        "exec": ["wget", "-q", "-O-", "http://localhost/"],
        "periodSeconds": 10,
        "failureThreshold": 3,
        "initialDelaySeconds": 5
      }
    },
    {
      "name": "worker",
      "image": "busybox:latest",
      "replicas": 3,
      "cmd": ["sh", "-c", "while true; do echo working; sleep 5; done"]
    }
  ]
}
